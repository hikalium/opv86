# Formats every source of the repository, not sdmparser.ts alone: a source
# which is left unformatted makes the next change to it either unformattable
# or full of unrelated lines.
format :
	sudo apt install clang-format
	make -C .. format

commit :
	make format
	make test
	make -C .. formatcheck
	git add ../
	git diff HEAD --color=always | less -R
	git commit

op_table.json : sdmparser.js
	node sdmparser.js --gen-op-table-only

sdmparser.js : sdmparser.ts sdm_instr.ts
	tsc -target es2019 --skipLibCheck --outFile sdmparser.js sdmparser.ts sdm_instr.ts

install :
	-make
	cp instr_list.json ../data
